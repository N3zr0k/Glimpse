# Ein Addon-Ordner im Repo (Glimpse/), alles andere liegt daneben. Der Packager baut im Ordner Glimpse, schiebt den
# Inhalt des Addon-Ordners eine Ebene hoch; was außen liegt, bleibt über "ignore" draußen.
package-as: Glimpse

move-folders:
  Glimpse/Glimpse: Glimpse

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Beziehungen auf CurseForge (Kurznamen der Projekte); externe Addons werden nicht gemeldet
embedded-libraries:
  - ace3

ignore:
  - tests
  - tools
  - docs
  - .github
  - .luacheckrc
  - .gitattributes
  - .gitignore
  - README.md
  - DEVELOPER.md
  - CHANGELOG.md
  - LICENSE
